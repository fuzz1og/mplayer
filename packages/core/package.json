    "pako": "^3.0.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11"
  },
