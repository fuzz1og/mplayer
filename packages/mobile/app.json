{
  "expo": {
    "name": "MPlayer",
    "slug": "mplayer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mplayer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mplayer.mobile"
    },
    "icon": "../../resources/icon.png",
    "android": {
      "package": "com.mplayer.mobile",
      "adaptiveIcon": {
        "foregroundImage": "../../resources/icon.png",
        "backgroundColor": "#1a1a2e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withVectorIconsFonts",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
