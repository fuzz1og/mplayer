{
  "expo": {
    "name": "MPlayer",
    "slug": "mplayer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mplayer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mplayer.mobile"
    },
    "android": {
      "package": "com.mplayer.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "./plugins/withVectorIconsFonts"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
