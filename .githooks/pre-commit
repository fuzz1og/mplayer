#!/bin/sh
# Pre-commit: typecheck (root + mobile) + lint staged files
set -e

# 快门禁前移（#717）：注释块与外部断言都是「写完才发现」的返工，各 <200ms，比等 verify 便宜
echo "→ comment-gate / claim-lint..."
node scripts/comment-gate.mjs
node scripts/claim-lint.mjs

echo "→ root typecheck..."
npx tsc --noEmit

# mobile typecheck 读 @mplayer/core 的 dist（不是源码）：pull / rebase 到动过 core 的 master 后
# dist 会落后，报出的是 TS2305「has no exported member」这类假错——看着像代码坏，其实是产物旧。
echo "→ core dist 新鲜度..."
CORE_DIST="packages/core/dist/index.d.ts"
if [ ! -f "$CORE_DIST" ] || [ -n "$(find packages/core/src -newer "$CORE_DIST" -print -quit)" ]; then
  echo "  dist 落后/缺失 → core:build"
  npm run core:build
fi

echo "→ mobile typecheck..."
npx tsc --noEmit --project packages/mobile/tsconfig.json

# staged lint 走 Node 分批（#654）：xargs 把全部文件塞进一条命令，Windows 下 300+ 文件会撞
# 命令行长度上限报「The command line is too long」；分批调用同时绕开 cmd.exe 与 CreateProcess 两条上限。
echo "→ lint..."
node scripts/lint-staged.mjs

echo "✓ pre-commit passed"
