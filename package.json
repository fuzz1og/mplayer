{
  "name": "mplayer",
  "version": "1.5.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A minimalist desktop music player built with Electron, React and TypeScript",
  "author": {
    "name": "t0nyst4",
    "email": "t0nyst4@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prebuild.js",
    "build": "npm run prebuild && tsc && vite build",
    "version:bump": "node scripts/version-bump.js",
    "version:check": "node scripts/version-bump.js --check",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "npx tsc --noEmit --project packages/mobile/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "core:build": "npm run build -w packages/core"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/howler": "^2.2.13",
    "antd": "^5.12.0",
    "axios": "^1.6.2",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "expo-build-properties": "^57.0.5",
    "fs-extra": "^11.2.0",
    "howler": "^2.2.4",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^1.7.0",
    "mp3tag.js": "^3.17.0",
    "music-metadata": "^11.12.3",
    "pinyin-pro": "^3.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.2",
    "zustand": "^4.4.7"
  },
  "overrides": {
    "esbuild": "0.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^41.7.1",
    "electron-builder": "^24.9.1",
    "esbuild": "0.25.2",
    "eslint": "^8.55.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.5",
    "wait-on": "^7.2.0"
  }
}
