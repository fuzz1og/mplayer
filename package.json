{
  "name": "mplayer",
  "version": "1.7.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A minimalist desktop music player built with Electron, React and TypeScript",
  "author": {
    "name": "t0nyst4",
    "email": "t0nyst4@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prebuild.js",
    "build": "npm run prebuild && tsc && vite build",
    "version:bump": "node scripts/version-bump.js",
    "version:check": "node scripts/version-bump.js --check",
    "migrate:legacy": "node scripts/migrate-legacy-storage.mjs",
    "preview": "vite preview",
    "electron:dev": "npm run core:build && node -e \"require('fs').rmSync('dist-electron/main.js',{force:true})\" && concurrently \"npm run dev\" \"wait-on http://localhost:5174 dist-electron/main.js && node scripts/start-electron-dev.mjs\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "npx tsc --noEmit --project packages/mobile/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:chart": "node scripts/testAggregatedChart.js",
    "core:build": "npm run build -w packages/core"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "mp3tag.js": "^3.17.0",
    "music-metadata": "^11.12.3"
  },
  "overrides": {
    "esbuild": "0.25.2"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/fs-extra": "^11.0.4",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^6.6.0",
    "axios": "^1.6.2",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "electron": "^41.7.1",
    "electron-builder": "^24.9.1",
    "esbuild": "0.25.2",
    "eslint": "^8.55.0",
    "expo": "~57.0.9",
    "fs-extra": "^11.2.0",
    "howler": "^2.2.4",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.7.0",
    "pinyin-pro": "^3.28.2",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.14.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.5",
    "wait-on": "^9.1.0",
    "zustand": "^4.4.7"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
