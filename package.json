{
  "name": "mplayer",
  "version": "1.8.7",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A minimalist desktop music player built with Electron, React and TypeScript",
  "homepage": "https://github.com/fuzz1og/mplayer",
  "author": {
    "name": "t0nyst4",
    "email": "t0nyst4@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prebuild.js",
    "build": "npm run prebuild && tsc && vite build",
    "version:bump": "node scripts/version-bump.js",
    "version:check": "node scripts/version-bump.js --check",
    "migrate:legacy": "node scripts/migrate-legacy-storage.mjs",
    "preview": "vite preview",
    "electron:dev": "npm run core:build && node -e \"require('fs').rmSync('dist-electron/main.js',{force:true})\" && concurrently \"npm run dev\" \"wait-on http://localhost:5174 dist-electron/main.js && node scripts/start-electron-dev.mjs\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "design-lint": "node scripts/design-lint.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "npx tsc --noEmit --project packages/mobile/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:main": "vitest run --config vitest.main.config.ts",
    "mobile:e2e": "node scripts/mobile-e2e.mjs",
    "mobile:debug": "node scripts/mobile-debug.mjs",
    "mobile:frame-stats": "node scripts/mobile-frame-stats.mjs",
    "mobile:usb-attach": "node scripts/mobile-device/usb-attach.mjs",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "release": "node scripts/release.mjs",
    "core:build": "npm run build -w packages/core",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "electron-updater": "^6.8.9",
    "mp3tag.js": "^3.17.0",
    "music-metadata": "^11.16.1"
  },
  "overrides": {
    "esbuild": "0.25.2",
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.9.12",
    "plist": "^3.1.1",
    "browserslist": "^4.28.9",
    "baseline-browser-mapping": "^2.11.23",
    "joi": "^18.2.9",
    "uuid": "^11.1.1",
    "shell-quote": "^1.11.0",
    "metro": "^0.84.5",
    "metro-config": "^0.84.5",
    "metro-transform-worker": "^0.84.5",
    "react-native": "0.86.3",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/howler": "^2.2.13",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.16.1",
    "esbuild": "0.25.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo": "~57.0.27",
    "fs-extra": "^11.4.0",
    "globals": "^17.13.0",
    "howler": "^2.2.4",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.49.0",
    "pinyin-pro": "^3.29.4",
    "prettier": "^3.9.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
